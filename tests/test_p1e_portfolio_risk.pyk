"""
MODULE: tests.test_p1e_portfolio_risk
DESCRIPTION: Comprehensive Test Suite for P1-E Risk Gate & Position Sizer.
"""

import pytest
from tokocrypto_bot.strategy.features import FeatureFrame
from tokocrypto_bot.strategy.decision import Decision, DecisionAction
from tokocrypto_bot.persistence.lifecycle_state import ApplicationState
from tokocrypto_bot.strategy.portfolio import (
    RiskGate, PositionSizer, PortfolioState, PortfolioRiskConfig,
    RiskAction, RiskState, MultiPairPortfolioRanker
)


@pytest.fixture
def risk_setup():
    config = PortfolioRiskConfig()
    gate = RiskGate(config)
    sizer = PositionSizer()
    
    feature_frame = FeatureFrame(
        timestamp=1700000000000, symbol="BTCUSDT", feature_version="2026.1.0",
        features={"ATR": 1000.0, "RSI14": 55.0}, is_valid=True
    )
    
    decision = Decision(
        symbol="BTCUSDT", timestamp=1700000000000, action=DecisionAction.BUY,
        probability=0.75, confidence=0.50, expected_value=0.03,
        stop_loss=48000.0, take_profit=54000.0, reason_codes=["EV_PASS"],
        strategy_version="2026.1.0", model_version="2026.1.0"
    )
    
    p_state_healthy = PortfolioState(
        total_equity_usdt=10000.0, available_balance_usdt=5000.0,
        current_portfolio_exposure_usdt=1000.0, daily_realized_pnl_usdt=50.0,
        peak_equity_usdt=10000.0, current_drawdown_pct=0.0,
        cusum_statistic=0.0, consecutive_losses=0,
        active_positions={"BTCUSDT": 1000.0}, app_lifecycle_state=ApplicationState.READY,
        is_reconciliation_clean=True, is_kill_switch_active=False
    )
    return gate, sizer, feature_frame, decision, p_state_healthy


def test_normal_risk_gate_allows_and_sizes_position(risk_setup):
    gate, sizer, ff, decision, p_state = risk_setup
    risk_dec = gate.evaluate_trade_risk(decision, ff, p_state, current_price=50000.0)
    
    assert risk_dec.action in (RiskAction.ALLOW, RiskAction.REDUCE)
    assert risk_dec.approved_notional > 0.0

    plan = sizer.create_position_plan(decision, risk_dec, current_price=50000.0)
    assert plan.action == DecisionAction.BUY
    assert plan.calculated_quantity > 0.0


def test_critical_lifecycle_state_rejects(risk_setup):
    gate, _, ff, decision, p_state = risk_setup
    unhealthy_state = PortfolioState(**{**p_state.__dict__, "app_lifecycle_state": ApplicationState.SAFE_MODE})
    
    risk_dec = gate.evaluate_trade_risk(decision, ff, unhealthy_state, current_price=50000.0)
    assert risk_dec.action == RiskAction.REJECT
    assert "CRITICAL_LIFECYCLE_STATE_SAFE_MODE" in risk_dec.reason_codes


def test_daily_loss_limit_triggers_halt(risk_setup):
    gate, _, ff, decision, p_state = risk_setup
    loss_state = PortfolioState(**{**p_state.__dict__, "daily_realized_pnl_usdt": -500.0}) # 5% loss > 4% limit
    
    assert gate.evaluate_risk_state(loss_state) == RiskState.HALTED
    risk_dec = gate.evaluate_trade_risk(decision, ff, loss_state, current_price=50000.0)
    assert risk_dec.action == RiskAction.REJECT
    assert "RISK_STATE_HALTED" in risk_dec.reason_codes


def test_exposure_cap_limits_sizing(risk_setup):
    gate, _, ff, decision, p_state = risk_setup
    # Set active position close to max single asset limit (15% of 10k = 1500)
    capped_state = PortfolioState(**{**p_state.__dict__, "active_positions": {"BTCUSDT": 1400.0}})
    
    risk_dec = gate.evaluate_trade_risk(decision, ff, capped_state, current_price=50000.0)
    assert risk_dec.approved_notional <= 100.0  # Max remaining 100 USDT
